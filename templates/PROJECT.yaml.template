# PROJECT.yaml — the project contract. AUTHORITATIVE, frozen after human
# authorization (HITL row 1, policy/hitl-matrix.md). Changing it after
# authorization is explicit change control, recorded in DECISIONS.md — not a
# silent edit.
#
# Nothing here names a worker configuration beyond the role class. The
# instantiated routing choices are private policy (policy/routing-policy.md).

project:
  name:                          # product-facing name
  repo_path:                     # absolute path to the working repository
  integration_ref:                # e.g. integration        — autonomous merges land here
  release_ref:                    # e.g. main / release      — human-gated only, HITL row 2
  autonomous_integration_merges:  # true | false — PROJECT.yaml is the sole authority for this

pack:
  # The pinned release, identified by all four of root + version + revision +
  # digest. The root says WHICH DIRECTORY; the other three say WHAT is in it.
  # The version alone is a label; two checkouts can carry it and differ. Record
  # every field from the pack's own PACK_MANIFEST.json and VERSION, then verify
  # them — a pin nobody checks is a sentence, not a pin:
  #
  #   python3 <pack_root>/tools/pack_pin.py <pack_root> \
  #       --version <version_adopted> --sha <sha_adopted> \
  #       --digest <tree_digest_sha256> --state QUALIFIED_AND_FROZEN
  #
  # Run it with the pack_pin.py inside the pinned root: the digest framing is
  # release-local and named in the manifest's `digest_algorithm`.
  root_path:                      # ABSOLUTE path to the pinned release directory
  version_adopted:                # runtime-pack-2 VERSION — the single version authority
  sha_adopted:                    # the full 40-character pack revision; abbreviations are refused
  tree_digest_sha256:             # PACK_MANIFEST.json tree_digest_sha256, verified not copied
  state_adopted: QUALIFIED_AND_FROZEN   # the only state a project may adopt
  adopted_at:                     # ISO date this pin was taken and verified
  adoption_boundary: "a newer pack version is adopted only at a capability boundary, never mid-capability"
  # retained_roots: previously verified release roots kept as ROLLBACK TARGETS.
  # Retention is not a guarantee: each is RE-VERIFIED before it is offered, and
  # one that has been deleted, edited or moved is reported unavailable rather
  # than used. Rolling back to a directory nobody has checked since it stopped
  # being the release it claims to be is not a rollback.
  # retained_roots: []
  #
  # ROOT_PATH IS REQUIRED FOR THE PIN TO BE CHECKABLE. Version + revision +
  # digest say WHAT the release is; root_path says WHICH DIRECTORY holds it, and
  # without it nothing can confirm the two are the same thing. It is
  # canonicalised before use — symlinks resolved, `..` removed — because D13
  # requires two qualified releases to resolve to DISTINCT immutable roots, and
  # a symlink is how two declarations that look distinct become one directory.
  #
  # A pin missing root_path, sha_adopted or tree_digest_sha256 is classified
  # UNVERIFIABLE_LEGACY_PIN (`tools/pack_migration.py`). That state is REPORTED
  # AT EVERY USE and is never repaired by writing today's values into it: the
  # release it named cannot be recovered, and today's values would produce a pin
  # that verifies and describes nothing. The remedy is to MIGRATE — which is
  # permitted from a legacy pin, and discloses that nothing can be concluded
  # about what was left behind.
  #
  # Migrating to another qualified release:
  #
  #   python3 <pack_root>/tools/pack_migration.py --project PROJECT.yaml \
  #       --index <install_root>/RELEASE_INDEX.json --to <version> \
  #       --at-capability-boundary
  #
  # The RELEASE INDEX lives OUTSIDE every release — a frozen release cannot list
  # the ones that come after it — so it is untrusted input: an entry is a CLAIM
  # that a release sits at a path, and the gate is what verifies it. A security
  # advisory on a target is disclosed loudly and authorises nothing: urgency is
  # a reason for a person to decide sooner, not a reason to skip the capability
  # boundary or the human.
  #
  # What this pin means, and what it deliberately does not:
  #
  # - A frozen release NEVER MUTATES during a project run. If verification stops
  #   passing mid-project, the checkout changed and that is a stop — not a pin
  #   to refresh.
  # - Several projects MAY PIN THE SAME release concurrently. A verified release
  #   root is read-only shared input; nothing in it is per-project state.
  # - Projects MAY PIN DIFFERENT qualified releases at the same time. Different
  #   versions must resolve to DISTINCT immutable roots — never one directory
  #   moved between revisions, which would make both pins unverifiable at once.
  # - Operational state and the Evolution Candidate inbox are PROJECT-LOCAL.
  #   A project never writes into the pack root: measured overhead, budget
  #   consumption and candidates live in this project's own PROGRESS.md and
  #   EVOLUTION_CANDIDATES.md.
  # - Candidates from several projects are pooled ONLY during a separate pack
  #   evolution session, which produces a new version. No project run evolves
  #   the pack it is pinned to.
  # - Each project adopts a new release INDEPENDENTLY, at its own next safe
  #   capability boundary. There is no coordinated upgrade and no scheduler.

adapters:
  # EXECUTABLE ADAPTERS — material that RUNS and lives OUTSIDE the pinned pack:
  # installed agent definitions, worker skills, dispatch templates. The pack
  # cannot freeze them (D12) and does not vendor them (D14 clause 10), so the
  # project declares which one it qualified against and verifies that claim:
  #
  #   python3 <pack_root>/tools/adapter_pin.py --project PROJECT.yaml
  #
  # VERIFIED AT EVERY CAPABILITY OPEN, before the first dispatch, alongside the
  # pack pin. A required adapter that does not match is a STOP, not a warning:
  # an unverified adapter has already run by the time anyone reads the report.
  #
  # Why this block exists, concretely: the installed reviewer adapter declared
  # `isolation: worktree` while the pinned reviewer contract forbids a reviewer
  # from creating a ref, a branch or a worktree — and the pack's own
  # publication gate refuses exactly the ref that mode creates. Every gate
  # passed. Nothing was looking at the adapter.
  #
  # Record a digest only after qualifying the adapter. To read the current one:
  #
  #   python3 <pack_root>/tools/adapter_pin.py --observe <path>
  #
  # That prints an OBSERVATION, not a verification, and nothing updates a
  # declared digest automatically — a checker that refreshes its own
  # expectation on mismatch is a checker that always passes.
  #
  # - id:        capability-auditor          # exact identity, referenced in briefs
  #   locator:   ~/.claude/agents/capability-auditor.md   # `~` expands to the invoking user's home
  #   digest:    <64-character lowercase sha256 of the file's bytes>
  #   required:  true                        # governs ABSENCE ONLY (see below)
  #   declares:  capability-auditor          # the name: the file must declare — a path is a locator, not an identity
  #   note:      "read-only reviewer; must not declare an isolation mode"
  #
  # `required: false` permits the adapter to be ABSENT. It does NOT permit it to
  # be different: a declared adapter that is present and does not match its
  # digest blocks either way. Unreadable blocks too — that is a failure to look,
  # not an absence.

requires:
  # WHICH PREREQUISITES THIS PROJECT MUST SATISFY before a capability opens.
  # Read by `tools/capability_open.py`, which is the single readiness path.
  #
  # Declared BY THE PROJECT, because Core cannot know which products have
  # durable semantic authority and a Core that decided would be adjudicating
  # product meaning. Not a list of project names in Core — that would be the
  # same decision, made in the wrong place and impossible to change without a
  # release.
  #
  #   project_context: false   (default) a fixture or a utility. Absence is clean.
  #   project_context: true    a product whose correctness depends on durable
  #                            semantic authority. Missing, stale or unverifiable
  #                            required context => NOT READY.
  #
  # A REQUIREMENT GOVERNS ABSENCE ONLY. A context that is DECLARED and cannot be
  # verified stops the open whether or not it was required — the same rule
  # `adapters:` already uses, and for the same reason: something in this project
  # consults it. `required: false` is a statement about needing one, never a
  # licence to proceed on one that could not be established.
  #
  # A key nothing checks is REFUSED rather than ignored, because a requirement
  # silently unread is worse than no requirement: the project believes it is
  # enforced.
  #
  # project_context: false

project_context:
  # PROJECT CONTEXT — the project's DURABLE SEMANTIC AND PRODUCT AUTHORITY:
  # what the product means, what it has decided, what is still open. Optional by
  # default; a project that declares none simply has no semantic authority to
  # consult and reports NOT_PRESENT, which is a clean state — unless the project
  # declared `requires.project_context: true` above, and then absence is a stop.
  #
  # THE CORE DOES NOT ADJUDICATE PRODUCT MEANING. `tools/project_context.py`
  # verifies IDENTITY — is the thing at the locator the revision this project
  # declared, unchanged since the capability opened — and reads none of its
  # contents. Product meaning is the project's authority; a governance layer
  # that graded it would hold state it also judged, which is what D1 forbids.
  # Project Context evolution is project-local and is a different thing from
  # Core evolution: a new pack release neither carries nor supersedes it.
  #
  # context_id:      PROJECT-CONTEXT-001    # project-local identity
  # reference_path:  /absolute/path/to/.project_context   # canonical locator, resolved
  # control_revision: 12                    # project-local, monotonic. NAMED FOR WHAT THE ONLY
  #                                          # REAL PROJECT CONTEXT IN EXISTENCE CALLS IT, after
  #                                          # this verifier shipped an invented spelling
  # digest:          <64-char sha256 over the context tree>
  # digest_algorithm: sha256-framed-tree-v1 # named, so a checkout carrying another fails as a version mismatch
  # authority_role:  DURABLE_SEMANTIC_PRODUCT_AUTHORITY   # the project's own words; recorded, never interpreted
  # activated:       true                   # declared-but-inactive is verified AND NOT CONSULTED — a third state
  # proposals_pending: 0                    # A PROPOSAL IS NOT AN ADOPTION and changes nothing about what the context says
  #
  # FIVE STATES, deliberately distinct:
  #   NOT_PRESENT         no context declared — fine
  #   DECLARED            declared, not yet verified this session — neither pass nor fail
  #   CURRENTLY_VERIFIED  located, and matching the declared revision and digest
  #   STALE               located and readable, and not what the declaration describes
  #   UNVERIFIABLE        declared and CANNOT BE CHECKED — the locator does not resolve, OR the
  #                       block leaves out an identity field. A stop, and not the same as
  #                       NOT_PRESENT. An ABSENT field lands here; a field written WRONG is an
  #                       error, because a typo somebody made is not an older shape.
  #
  # Verify at capability open, and observe a digest deliberately:
  #
  #   python3 <pack_root>/tools/project_context.py --project PROJECT.yaml
  #   python3 <pack_root>/tools/project_context.py --observe <reference_path>
  #
  # `--observe` prints an OBSERVATION, not a verification. Nothing updates a
  # declared digest automatically.
  #
  # NO SILENT MUTATION DURING A CAPABILITY. The digest is taken at capability
  # open and recomputed at close. A context that changed in between makes that
  # capability's evidence UNINTERPRETABLE — it was produced against a semantic
  # authority that no longer exists — so it is a stop, not a refresh. Proving
  # non-mutation is showing the same digest twice.

dimensions:
  # Declared validation dimensions for this project. Every capability's
  # SCOPE.md selects a subset of these; a dimension not selected here may not
  # be invented mid-capability.
  - name:
    real_system_required:        # true | false
    critical:                    # true | false — critical dimensions require the two-auditor tier (policy/auditor-strategy.md)

validation_profiles:
  # The actual command for each. Task gates run `focused` only; capability
  # closure runs `full` once, at the exact head.
  focused:
    command:
    typical_wall_clock_seconds:
  integration:
    command:
    typical_wall_clock_seconds:
  full:
    command:
    typical_wall_clock_seconds:
  # A data-science project usually needs a notebook-execution profile. Two
  # traps, both measured, both cheap to avoid:
  #   - PYTHONPATH must be ABSOLUTE. `nbconvert --execute` launches the kernel
  #     with the NOTEBOOK's directory as cwd, so a relative `src` resolves to
  #     `notebooks/src` and every import fails. It looks exactly like a missing
  #     install, and rebuilding the virtualenv does not fix it.
  #   - execute and check output hygiene separately: a notebook that runs is not
  #     a notebook whose committed outputs are clean.
  # notebook:
  #   command: >
  #     PYTHONPATH="$PWD/src" jupyter nbconvert --to notebook --execute
  #     --inplace notebooks/analysis.ipynb && python3 scripts/check_outputs.py
  #   typical_wall_clock_seconds:

data_provenance:
  # Optional, and required in practice for any project whose result depends on
  # data it did not generate — without these a "reproducible" pipeline is not.
  # source_url:
  # licence:
  # snapshot_date:
  # revision:                    # upstream revision or dump id, where one exists
  # sha256:                      # of the retrieved artifact, not of your copy
  # expected_record_count:

mutation_policy:
  autonomous_fix_paths:          # paths where a capability's mutation boundary permits autonomous repair
  escalation_on_boundary_exit: "HITL row 10 — scope insufficiency crossing a capability boundary"

private_terms:
  default_set: policy/private-terms.default.json
  # This project's own vocabulary. It EXTENDS the default set; it never replaces
  # it, and every tool loads the defaults whether or not this file names them.
  #
  # Run a candidate term against your own tree BEFORE adopting it. Private
  # vocabularies are chosen by process people and collide with domain
  # vocabularies chosen by nobody: one project declared `bootstrap` and its own
  # domain use of the word tripped the gate. Prefer multi-word terms.
  project_additions:
  project_patterns:              # regexes; verify each against your own tree first
  # Opt-in pattern groups from the default set. `ticket_ids` is off by default:
  # `\b[A-Z]{2,4}-\d{1,4}\b` matches utf-8, SHA-256, post-2011 and nearly every
  # lockfile entry — 7 findings, 0 true positives, on one project's first six
  # commits. Adopt it only if this project really emits ticket identifiers.
  optional_pattern_groups: []    # e.g. ["ticket_ids"]

publication:
  # Refs a push may carry. Everything else — notes refs, recovery branches,
  # agent worktree branches — fails `tools/publication_gate.py`. A clean branch
  # history is not a publishable repository: `refs/notes/*` is invisible to
  # git log, status, ls-files, diff and show.
  publishable_refs: ["refs/heads/*", "refs/tags/*"]

  # THE PUSH FORM IS NOT PROJECT-CONFIGURABLE. It is fixed by the pack, in
  # `tools/publication_gate.py` as `SUPPORTED_PUSH_FORM`, and stated once:
  #
  #     git push <remote> refs/heads/<branch>:refs/heads/<branch>
  #
  # One remote, one explicit non-wildcard refspec, nothing else. Never
  # `--mirror`, `--all`, `--tags`, or a second refspec. The same string is what
  # the gate checks, what the publication runbook prints and what is actually
  # run — planning, gating and execution read one canonical form, because a
  # form restated in three places is three forms that will eventually differ.
  # A release-integrity test compares every restatement in this release against
  # the constant, so a drifted copy cannot be committed.

workspace_classification:
  # Inputs to `tools/workspace_report.py`, run at capability OPEN and CLOSE.
  # The tool ships with an EMPTY safe-generated set on purpose: an artifact is
  # classified because the project said so, not because a tool guessed. Anything
  # undeclared is `unknown` and blocks closure.
  #
  # Patterns follow GITIGNORE semantics, not fnmatch: a trailing slash covers a
  # directory and everything beneath it, a leading slash anchors to the
  # repository root, and a bare name matches at any depth. `*` does NOT cross a
  # directory separator — `__pycache__/*` will silently miss `src/x/__pycache__/y`.
  safe_generated:                # e.g. ["__pycache__/", ".pytest_cache/", "dist/"]
  ignore_private:                # ignored files that are private, not merely generated

  # Paths this project REQUIRES to be tracked. The classification buckets ask
  # "has somebody said what this file is"; a file that never arrived is not
  # unclassified, it is absent, and absence is what a bucket check cannot see.
  # A machine-level `core.excludesFile` once excluded `*.jsonl` while a
  # project's required files were JSONL in a tracked directory. `git add` committed
  # nothing, silently, and every gate stayed green.
  must_be_tracked:               # e.g. ["annotations/", "data/gold.csv"]

  # Content-exempt paths for `tools/outgoing_scan.py`. Narrow and deliberate:
  # a file that IS the denylist, a negative fixture, or a reviewed-baseline
  # record naming a prior match. Exemption covers blob CONTENT only — the path,
  # every ref and tag name, every message and identity are still scanned, and
  # each exempted file is named in the report, so a clean scan still discloses
  # what it declined to read. GITIGNORE semantics apply here too, as above:
  # `annotations/` covers everything beneath it. (This field used fnmatch until
  # RP2.1, under which `annotations/` matched nothing at all and said so
  # nowhere — the scan simply reported normally. A declaration matching no path
  # is now reported as matching nothing.)
  #
  # A capability whose mutation boundary writes into an exempt path cannot close
  # without an evidence entry saying what actually landed there: exemptions are
  # declared before the files exist and their scope grows silently otherwise.
  content_exempt:                # e.g. ["REVIEWED-BASELINE.md", "annotations/"]

critical_domains:
  # Domains whose capabilities require the two-auditor tier and the human
  # acceptance protocol at closure, regardless of the routine default.
  - name:
    reason:

hitl_selections:
  cadence: "batched at capability boundaries"     # the vNext/RP2.0 default; record if this project departs
  audit_sampling_rate:            # 0-100, used in sha256(head_sha || salt) mod 100 < rate (policy/auditor-strategy.md)
  audit_sampling_salt:            # recorded so the sampling is independently verifiable

capabilities:
  # One row per capability. The authoritative detail for each lives in
  # capabilities/<id>/SCOPE.md; this is the index, not a duplicate record.
  #
  # DO NOT add a `status:` field here. Lifecycle status is owned by ROADMAP.md
  # (across capabilities) and PROGRESS.md (within one). A status recorded here
  # goes stale the moment work starts, and a cold-continuation drill caught
  # exactly that: PROJECT.yaml said PLANNED while PROGRESS.md said TASKING, and
  # the reconstructing coordinator had to infer which file wins.
  - id:
    goal:
    depends_on: []
    requirements: []              # requirement IDs from the coverage register this capability closes

approval:
  proposed_at:
  approved_by:
  approved_at:
  frozen_at_revision:
