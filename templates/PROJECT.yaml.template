# PROJECT.yaml — the project contract. AUTHORITATIVE, frozen after human
# authorization (HITL row 1, policy/hitl-matrix.md). Changing it after
# authorization is explicit change control, recorded in DECISIONS.md — not a
# silent edit.
#
# Nothing here names a worker configuration beyond the role class. The
# instantiated routing choices are private policy (policy/routing-policy.md).

project:
  name:                          # product-facing name
  repo_path:                     # absolute path to the working repository
  integration_ref:                # e.g. integration        — autonomous merges land here
  release_ref:                    # e.g. main / release      — human-gated only, HITL row 2
  autonomous_integration_merges:  # true | false — PROJECT.yaml is the sole authority for this

pack:
  version_adopted:                # runtime-pack-2 VERSION this project is pinned to
  adoption_boundary: "a newer pack version is adopted only at a capability boundary, never mid-capability"

dimensions:
  # Declared validation dimensions for this project. Every capability's
  # SCOPE.md selects a subset of these; a dimension not selected here may not
  # be invented mid-capability.
  - name:
    real_system_required:        # true | false
    critical:                    # true | false — critical dimensions require the two-auditor tier (policy/auditor-strategy.md)

validation_profiles:
  # The actual command for each. Task gates run `focused` only; capability
  # closure runs `full` once, at the exact head.
  focused:
    command:
    typical_wall_clock_seconds:
  integration:
    command:
    typical_wall_clock_seconds:
  full:
    command:
    typical_wall_clock_seconds:
  # A data-science project usually needs a notebook-execution profile. Two
  # traps, both measured, both cheap to avoid:
  #   - PYTHONPATH must be ABSOLUTE. `nbconvert --execute` launches the kernel
  #     with the NOTEBOOK's directory as cwd, so a relative `src` resolves to
  #     `notebooks/src` and every import fails. It looks exactly like a missing
  #     install, and rebuilding the virtualenv does not fix it.
  #   - execute and check output hygiene separately: a notebook that runs is not
  #     a notebook whose committed outputs are clean.
  # notebook:
  #   command: >
  #     PYTHONPATH="$PWD/src" jupyter nbconvert --to notebook --execute
  #     --inplace notebooks/analysis.ipynb && python3 scripts/check_outputs.py
  #   typical_wall_clock_seconds:

data_provenance:
  # Optional, and required in practice for any project whose result depends on
  # data it did not generate — without these a "reproducible" pipeline is not.
  # source_url:
  # licence:
  # snapshot_date:
  # revision:                    # upstream revision or dump id, where one exists
  # sha256:                      # of the retrieved artifact, not of your copy
  # expected_record_count:

mutation_policy:
  autonomous_fix_paths:          # paths where a capability's mutation boundary permits autonomous repair
  escalation_on_boundary_exit: "HITL row 10 — scope insufficiency crossing a capability boundary"

private_terms:
  default_set: policy/private-terms.default.json
  # This project's own vocabulary. It EXTENDS the default set; it never replaces
  # it, and every tool loads the defaults whether or not this file names them.
  #
  # Run a candidate term against your own tree BEFORE adopting it. Private
  # vocabularies are chosen by process people and collide with domain
  # vocabularies chosen by nobody: one project declared `bootstrap` and its own
  # domain use of the word tripped the gate. Prefer multi-word terms.
  project_additions:
  project_patterns:              # regexes; verify each against your own tree first
  # Opt-in pattern groups from the default set. `ticket_ids` is off by default:
  # `\b[A-Z]{2,4}-\d{1,4}\b` matches utf-8, SHA-256, post-2011 and nearly every
  # lockfile entry — 7 findings, 0 true positives, on one project's first six
  # commits. Adopt it only if this project really emits ticket identifiers.
  optional_pattern_groups: []    # e.g. ["ticket_ids"]

publication:
  # Refs a push may carry. Everything else — notes refs, recovery branches,
  # agent worktree branches — fails `tools/publication_gate.py`. A clean branch
  # history is not a publishable repository: `refs/notes/*` is invisible to
  # git log, status, ls-files, diff and show.
  publishable_refs: ["refs/heads/*", "refs/tags/*"]

workspace_classification:
  # Inputs to `tools/workspace_report.py`, run at capability OPEN and CLOSE.
  # The tool ships with an EMPTY safe-generated set on purpose: an artifact is
  # classified because the project said so, not because a tool guessed. Anything
  # undeclared is `unknown` and blocks closure.
  #
  # Patterns follow GITIGNORE semantics, not fnmatch: a trailing slash covers a
  # directory and everything beneath it, a leading slash anchors to the
  # repository root, and a bare name matches at any depth. `*` does NOT cross a
  # directory separator — `__pycache__/*` will silently miss `src/x/__pycache__/y`.
  safe_generated:                # e.g. ["__pycache__/", ".pytest_cache/", "dist/"]
  ignore_private:                # ignored files that are private, not merely generated

  # Paths this project REQUIRES to be tracked. The classification buckets ask
  # "has somebody said what this file is"; a file that never arrived is not
  # unclassified, it is absent, and absence is what a bucket check cannot see.
  # A machine-level `core.excludesFile` once excluded `*.jsonl` while a
  # project's required files were JSONL in a tracked directory. `git add` committed
  # nothing, silently, and every gate stayed green.
  must_be_tracked:               # e.g. ["annotations/", "data/gold.csv"]

  # Content-exempt paths for `tools/outgoing_scan.py`. Narrow and deliberate:
  # a file that IS the denylist, a negative fixture, or a reviewed-baseline
  # record naming a prior match. Exemption covers blob CONTENT only — the path,
  # every ref and tag name, every message and identity are still scanned, and
  # each exempted file is named in the report, so a clean scan still discloses
  # what it declined to read. GITIGNORE semantics apply here too, as above:
  # `annotations/` covers everything beneath it. (This field used fnmatch until
  # RP2.1, under which `annotations/` matched nothing at all and said so
  # nowhere — the scan simply reported normally. A declaration matching no path
  # is now reported as matching nothing.)
  #
  # A capability whose mutation boundary writes into an exempt path cannot close
  # without an evidence entry saying what actually landed there: exemptions are
  # declared before the files exist and their scope grows silently otherwise.
  content_exempt:                # e.g. ["REVIEWED-BASELINE.md", "annotations/"]

critical_domains:
  # Domains whose capabilities require the two-auditor tier and the human
  # acceptance protocol at closure, regardless of the routine default.
  - name:
    reason:

hitl_selections:
  cadence: "batched at capability boundaries"     # the vNext/RP2.0 default; record if this project departs
  audit_sampling_rate:            # 0-100, used in sha256(head_sha || salt) mod 100 < rate (policy/auditor-strategy.md)
  audit_sampling_salt:            # recorded so the sampling is independently verifiable

capabilities:
  # One row per capability. The authoritative detail for each lives in
  # capabilities/<id>/SCOPE.md; this is the index, not a duplicate record.
  #
  # DO NOT add a `status:` field here. Lifecycle status is owned by ROADMAP.md
  # (across capabilities) and PROGRESS.md (within one). A status recorded here
  # goes stale the moment work starts, and a cold-continuation drill caught
  # exactly that: PROJECT.yaml said PLANNED while PROGRESS.md said TASKING, and
  # the reconstructing coordinator had to infer which file wins.
  - id:
    goal:
    depends_on: []
    requirements: []              # requirement IDs from the coverage register this capability closes

approval:
  proposed_at:
  approved_by:
  approved_at:
  frozen_at_revision:
