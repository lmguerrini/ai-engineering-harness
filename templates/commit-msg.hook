#!/bin/sh
# The public commit contract, enforced by Git rather than by the caller.
#
# WHY THIS EXISTS. `commit_gate.py` is a separate process, so whether its
# refusal stops a commit depends on the caller reading its exit status. In this
# pack's own 2.4.0 development that dependency failed exactly once and it was
# enough: the gate was run, printed VIOLATION and exited non-zero, and the
# commit happened anyway, because the `&&` in
#
#     python3 tools/commit_gate.py "$MSG" ... | tail -1 && git commit -F "$MSG"
#
# attached to `tail`, which succeeded. Repairing that message needed a founder
# authorisation and a history rewrite.
#
# A `commit-msg` hook removes the dependency instead of adding another check:
# Git runs it and refuses the commit on a non-zero exit, whatever the caller's
# shell does with pipes, `&&`, `;` or a swallowed status.
#
# INSTALL IT — the pack does not, because writing into a project's `.git` is the
# project's decision:
#
#     cp <pack-root>/templates/commit-msg.hook .git/hooks/commit-msg
#     chmod +x .git/hooks/commit-msg
#
# and point it at the pack:
#
#     git config runtimepack.root <pack-root>
#
# WHAT IT DOES NOT COVER, stated so `--no-verify` is not a reader's whole model:
# Git does not run `commit-msg` when a commit is REPLAYED. `git cherry-pick` and
# `git rebase` land a message this hook would refuse, with no `--no-verify` and
# nothing disabled — verified by an independent reader against git 2.50.1.
# `commit_gate.py --range` catches a replayed message afterwards, which is where
# a replay is caught, and this release runs it over the whole delta.
#
# `--no-verify` bypasses it too, and deliberately: a hook that cannot be bypassed
# is a hook people stop installing. What the hook removes is the ACCIDENTAL
# bypass — a caller not reading an exit status — which is the one that happened.
set -eu

MESSAGE_FILE="$1"

PACK_ROOT=$(git config --get runtimepack.root || true)
if [ -z "$PACK_ROOT" ]; then
    echo "commit-msg: runtimepack.root is not configured, so the commit contract cannot be" >&2
    echo "            checked. Run: git config runtimepack.root <pack-root>" >&2
    echo "            REFUSING, because a check that cannot run is not a check that passed." >&2
    exit 1
fi

GATE="$PACK_ROOT/tools/commit_gate.py"
if [ ! -f "$GATE" ]; then
    echo "commit-msg: no commit gate at $GATE — REFUSING rather than passing." >&2
    exit 1
fi

# THE PROJECT'S OWN VOCABULARY, NOT ONLY THE DEFAULTS. A project EXTENDS the
# default term set in its `PROJECT.yaml`; a hook that passed `--default-terms`
# alone checked the inherited words and none of the project's own, so a message
# carrying a term the project had itself declared private was refused by
# `commit_gate.py --project` and committed by `git commit`. Found by an
# independent reader of the candidate that shipped this file.
#
# The contract is found by declaration first and by convention second, and where
# one exists it REPLACES the defaults argument rather than adding to it —
# `--project` already inherits the defaults, which is what "extends" means.
CONTRACT=$(git config --get runtimepack.contract || true)
if [ -z "$CONTRACT" ]; then
    REPO_TOP=$(git rev-parse --show-toplevel 2>/dev/null || true)
    if [ -n "$REPO_TOP" ] && [ -f "$REPO_TOP/PROJECT.yaml" ]; then
        CONTRACT="$REPO_TOP/PROJECT.yaml"
    fi
fi

# No pipe. The exit status of the gate is the exit status of this hook, which is
# the entire point of the file.
if [ -n "$CONTRACT" ]; then
    python3 "$GATE" "$MESSAGE_FILE" --project "$CONTRACT"
else
    python3 "$GATE" "$MESSAGE_FILE" --default-terms "$PACK_ROOT"
fi
