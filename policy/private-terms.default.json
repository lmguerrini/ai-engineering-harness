{
  "policy_schema": 1,
  "description": "Default private-term set inherited by an ordinary governed project. A project may replace or extend this in project.yaml. This is a default, never a universal hard-coded list: a vocabulary built for one project silently fails to protect another.",
  "applies_to": "outgoing commit messages, branch and tag names, and the full outgoing object range",
  "terms": [
    "anthropic",
    "audit capsule",
    "audit session",
    "auditor verdict",
    "capability branch",
    "capability closure audit",
    "capsule hash",
    "capsule sha",
    "claim strength",
    "claude",
    "closure audit",
    "codex",
    "coordinator",
    "cross-vendor audit",
    "dispatch id",
    "engineering harness",
    "envelope",
    "evidence class",
    "fencing token",
    "finding registry",
    "fresh-context audit",
    "gpt-5",
    "haiku",
    "harness",
    "hitl",
    "human-in-the-loop",
    "luna",
    "mlx",
    "mutation boundary",
    "not_chosen",
    "opencode",
    "opus",
    "orchestrator",
    "private ledger",
    "probationary",
    "product bug gate",
    "qwen",
    "routing decision",
    "runtime pack",
    "runtime.sqlite",
    "sol",
    "sonnet",
    "spark",
    "state digest",
    "targeted repair audit",
    "task capsule",
    "task class",
    "terra",
    "worker adapter",
    "worker envelope",
    "write lease"
  ],
  "patterns": [
    "\\btask[ _-]?(?:id|uuid)\\b",
    "\\b[A-Z]{2,4}-\\d{1,4}\\b",
    "\\bT\\d+\\.\\d+\\b",
    "\\b(?:part|phase|step|milestone|roadmap)[ _-]?\\d+\\b",
    "\\bcapability[ _-]?\\d+\\b",
    "\\bfeat\\([a-z0-9]+-t\\d+\\)",
    "\\bauditor?[ _-]?(?:verdict|session)\\b",
    "\\b(?:blocking|non-blocking)[ _-]?event\\b"
  ]
}
